# 依赖与缓存
node_modules/
.DS_Store
*.log

# promptfoo 本地缓存（eval 结果不入库，配置入库）
.promptfoo/
promptfoo/output/

# 临时目录与 Python 字节码缓存
.tmp/
__pycache__/

# req-discovery 草稿工作区（本地草稿，不入库）
req-discovery-workspace/

# skill 输出的音视频二进制（不入 git 增重；文本报告 .md/.html 仍入库）
*.m4a
*.mp4

# 关键：生成产物【不要】ignore —— CI drift gate 依赖它们被提交后再比对
# 即不要在这里写 CLAUDE.md / AGENTS.md / .cursor/ / .claude/ / .codex/ / .github/
